# Boolean flags accept only "true" or "false" — any other value (e.g. "1",
# "yes") fails env validation at boot rather than being silently treated as false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_USE_MOCKS=true

BACKEND_INTERNAL_URL=http://localhost:3000/api
SESSION_COOKIE_NAME=nexio_session
# REFRESH_COOKIE_NAME=nexio_refresh
SESSION_COOKIE_SECURE=false

# nexio-workflow (the workflow engine) — server-only, so it is never bundled
# into the browser and the service does not need to be internet-reachable or to
# allow CORS. Leave it unset to run without workflows: /admin/workflows then
# renders a "not configured" state instead of failing the boot (with
# NEXT_PUBLIC_USE_MOCKS=true the mock layer serves it instead).
# WORKFLOW_INTERNAL_URL=http://localhost:8080

# Forward the nexio-core access token to nexio-workflow as a Bearer header.
# Keep it "false" until nexio-workflow actually accepts nexio-core's JWT — see
# §9 of its docs/FRONTEND-INTEGRATION.md; today every operation there is
# anonymous, so forwarding only widens where our credential is exposed. The code
# path exists, so flipping this to "true" is the whole change on our side.
# WORKFLOW_FORWARD_JWT=false

# Comma-separated hostname globs allowed through the next/image optimizer, e.g.
# "cdn.nexio.com,*.imgix.net". REQUIRED in production: env validation fails the
# boot when it's unset, and next.config falls back to an empty allowlist (all
# remote images blocked) rather than an open image proxy. In development it
# falls back to "**" (any HTTPS host) for convenience.
# NEXT_PUBLIC_IMAGE_HOSTNAMES=cdn.example.com

# Multi-tenant white-label. Tenant is resolved by subdomain first
# (acme.app.com -> "acme"), then this env var, then the default ("nexio").
# Registered tenants live in lib/tenant/config.ts. Try "sertao" to preview
# the alternate (amber) theme/branding locally.
# NEXT_PUBLIC_TENANT=nexio

# Optional: artificial latency added to every mock call (ms). Default 0.
# Set to e.g. 300 to simulate a slow backend and watch the route skeletons.
# MOCK_DELAY_MS=300

# DEV ONLY. Password the dev account switcher (bottom-right FAB, dev builds only)
# sends to /api/auth/login when jumping between seed accounts. Against the mock
# backend any 4+ char password works, so this can stay unset. Set it to your
# shared BACKEND seed password to switch accounts against a real backend.
# WARNING: this is inlined into the dev client bundle (NEXT_PUBLIC_) — only ever
# use it for throwaway seed accounts that guard nothing sensitive, and NEVER set
# it in the production environment.
# NEXT_PUBLIC_DEV_SEED_PASSWORD=
