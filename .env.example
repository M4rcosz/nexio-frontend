NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_USE_MOCKS=true

BACKEND_INTERNAL_URL=http://localhost:3000/api
SESSION_COOKIE_NAME=raizes_session
SESSION_COOKIE_SECURE=false

# Multi-tenant white-label. Tenant is resolved by subdomain first
# (acme.app.com -> "acme"), then this env var, then the default ("raizes").
# Registered tenants live in lib/tenant/config.ts. Try "sertao" to preview
# the alternate (amber) theme/branding locally.
# NEXT_PUBLIC_TENANT=raizes

# Optional: artificial latency added to every mock call (ms). Default 0.
# Set to e.g. 300 to simulate a slow backend and watch the route skeletons.
# MOCK_DELAY_MS=300
